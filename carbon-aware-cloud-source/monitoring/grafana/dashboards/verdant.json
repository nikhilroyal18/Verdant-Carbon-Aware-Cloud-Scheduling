{
  "uid": "verdant-lab",
  "title": "Verdant · Scheduling & API monitoring",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "carbon-aware",
    "simulation"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Modeled experiment outcomes are latest-run gauges; their graph timestamps are scrape time, not simulated time. API metrics are actual service measurements.",
  "panels": [
    {
      "id": 1,
      "title": "Modeled carbon emissions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verdant-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "verdant_simulated_carbon_grams",
          "refId": "A",
          "legendFormat": "{{strategy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:gCO₂e",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
